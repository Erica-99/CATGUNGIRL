[gd_resource type="Resource" script_class="TutorialStep" format=3 uid="uid://g0584puy43u"]

[ext_resource type="Script" uid="uid://crdw2cwt2ffb5" path="res://resources/tutorial_steps/tutorial_step.gd" id="1_0epor"]

[resource]
script = ExtResource("1_0epor")
title = "Jumping and Dashing"
description_kbm = "To jump, press [img height=48]res://art/UI/Glyphs/KBM/Dark/Space_Key_Dark.png[/img]. You can hold the button to jump higher.

You can also perform a dash using [img height=48]res://art/UI/Glyphs/KBM/Dark/A_Key_Dark.png[/img]/[img height=48]res://art/UI/Glyphs/KBM/Dark/D_Key_Dark.png[/img] and [img height=48]res://art/UI/Glyphs/KBM/Dark/Shift_Key_Dark.png[/img]."
description_gamepad = "To jump, press [img height=48]res://art/UI/Glyphs/Xbox/XboxSeriesX_A.png[/img]. You can hold the button to jump higher.

You can also perform a dash using [img height=48]res://art/UI/Glyphs/Xbox/XboxSeriesX_Left_Stick.png[/img] and [img height=48]res://art/UI/Glyphs/Xbox/XboxSeriesX_B.png[/img]."
description_playstation = "To jump, press [img height=48]res://art/UI/Glyphs/PS5/PS5_Cross.png[/img]. You can hold the button to jump higher.

You can also perform a dash using [img height=48]res://art/UI/Glyphs/PS5/PS5_Left_Stick.png[/img] and [img height=48]res://art/UI/Glyphs/PS5/PS5_Circle.png[/img]."
task = "Task: Perform a jump and a dash"
buttons = Array[StringName]([&"jump", &"dash"])
metadata/_custom_type_script = "uid://crdw2cwt2ffb5"
